# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and only used for local runs; in GitHub Actions
# these come from repository secrets instead.

# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Target chat id. Send a message to your bot, then call
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
CHAT_ID=123456789

# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model (defaults to gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest

# Optional: occasional personal check-in line appended to the message.
# CHECKIN_NAME is who it's addressed to (default: Sreeja).
# CHECKIN_PROBABILITY is the per-run chance (0.0-1.0) of adding it (default: 0.10).
# CHECKIN_NAME=Sreeja
# CHECKIN_PROBABILITY=0.10

